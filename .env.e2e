# E2E Testing Environment Variables

# Application URL
E2E_BASE_URL=http://localhost:3000

# Test User Credentials (created during global setup)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Test Configuration
E2E_HEADLESS=true
E2E_SLOW_MO=0
E2E_TIMEOUT=30000

# Demo Mode (if applicable)
E2E_DEMO_MODE=true

# Database Configuration (for test data cleanup)
E2E_DATABASE_URL=

# File Upload Configuration
E2E_MAX_FILE_SIZE=10485760
E2E_UPLOAD_TIMEOUT=60000

# Payment Testing (use test keys only)
E2E_STRIPE_PUBLISHABLE_KEY=pk_test_...
E2E_PAYPAL_CLIENT_ID=test_client_id

# Email Testing (optional)
E2E_EMAIL_PROVIDER=
E2E_EMAIL_API_KEY=

# Browser Configuration
E2E_BROWSER=chromium
E2E_DEVICE=Desktop Chrome

# Performance Testing
E2E_PERFORMANCE_BUDGET=5000
E2E_LIGHTHOUSE_ENABLED=false

# Screenshot and Video Configuration
E2E_SCREENSHOT_MODE=only-on-failure
E2E_VIDEO_MODE=retain-on-failure

# Parallel Testing
E2E_WORKERS=4
E2E_RETRIES=2

# Test Data
E2E_TEST_DATA_PATH=./e2e/fixtures
E2E_CLEANUP_AFTER_TESTS=true