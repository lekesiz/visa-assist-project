# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Services (At least one required)
# OpenAI
OPENAI_API_KEY=sk-...your-key-here
OPENAI_ORG_ID=org-...your-org-id (optional)

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Payment Services
# Stripe
STRIPE_SECRET_KEY=sk_test_...your-key-here
STRIPE_WEBHOOK_SECRET=whsec_...your-secret-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...your-key-here

# PayPal
PAYPAL_CLIENT_ID=your-client-id-here
PAYPAL_CLIENT_SECRET=your-client-secret-here
PAYPAL_MODE=sandbox # or 'live' for production

# Email Service
SENDGRID_API_KEY=SG.your-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Visa Assist

# Optional Services
# Google Maps (for appointment locations)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...your-key-here

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=your-auth-token

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (if using external DB in addition to Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/visa_assist

# Redis (for advanced rate limiting - optional)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_PAYMENT_FEATURES=true
ENABLE_EMAIL_FEATURES=true
ENABLE_DEMO_MODE=true