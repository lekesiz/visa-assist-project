{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "visa-assist-ai",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_ENV": "production",
      "VERCEL_ENV": "production"
    }
  },

  "functions": {
    "app/api/**": {
      "maxDuration": 30
    },
    "app/api/ai/**": {
      "maxDuration": 60
    },
    "app/api/documents/upload/**": {
      "maxDuration": 30
    },
    "app/api/payments/**": {
      "maxDuration": 25
    }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.openai.com https://api.anthropic.com https://api.stripe.com https://www.google-analytics.com; frame-src 'self' https://js.stripe.com https://www.paypal.com; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://visaassist.ai"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    },
    {
      "source": "/(.*\\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|avif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/faq",
      "permanent": false
    },
    {
      "source": "/help",
      "destination": "/contact",
      "permanent": false
    }
  ],

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/webhooks/stripe",
      "destination": "/api/payments/webhooks/stripe"
    },
    {
      "source": "/api/webhooks/paypal",
      "destination": "/api/payments/webhooks/paypal"
    }
  ],

  "trailingSlash": false,
  "cleanUrls": true,
  "regions": ["fra1", "iad1"],

  "env": {
    "NEXT_PUBLIC_VERCEL_ENV": "production",
    "NEXT_PUBLIC_APP_ENV": "production"
  },

  "github": {
    "enabled": false
  },

  "crons": [
    {
      "path": "/api/cron/cleanup-temp-files",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/update-job-listings",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/backup-data",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/analytics-report",
      "schedule": "0 1 * * 1"
    }
  ]
}