# Staging Environment Variables Template
# Copy this file to configure your staging environment

# ============================================================================
# DATABASE - Supabase Staging
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-service-role-key

# ============================================================================
# AI PROVIDERS - Staging/Test Keys
# ============================================================================
OPENAI_API_KEY=sk-proj-your-staging-openai-key
ANTHROPIC_API_KEY=sk-ant-api03-your-staging-anthropic-key
GOOGLE_AI_KEY=AIzaSy-your-staging-google-ai-key

# ============================================================================
# PAYMENT PROVIDERS - Test Mode
# ============================================================================
# Stripe Test
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret
STRIPE_WEBHOOK_SECRET=whsec_your-test-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-publishable

# PayPal Sandbox
PAYPAL_CLIENT_ID=AY-your-sandbox-paypal-client-id
PAYPAL_SECRET=your-sandbox-paypal-secret
PAYPAL_MODE=sandbox

# ============================================================================
# EMAIL SERVICE - Staging
# ============================================================================
SENDGRID_API_KEY=SG.your-staging-sendgrid-key
EMAIL_FROM=staging@visaassist.ai
EMAIL_REPLY_TO=staging-support@visaassist.ai
EMAIL_ADMIN=staging-admin@visaassist.ai

# ============================================================================
# FILE STORAGE - Staging AWS S3
# ============================================================================
AWS_S3_BUCKET=visa-assist-documents-staging
AWS_ACCESS_KEY_ID=AKIA-your-staging-aws-key
AWS_SECRET_ACCESS_KEY=your-staging-aws-secret
AWS_REGION=eu-central-1
AWS_CLOUDFRONT_DOMAIN=d987654321.cloudfront.net

# ============================================================================
# SECURITY - Staging
# ============================================================================
NEXTAUTH_SECRET=your-staging-nextauth-secret-32-chars-min
NEXTAUTH_URL=https://staging.visaassist.ai
JWT_SECRET=your-staging-jwt-secret-32-chars-min
ENCRYPTION_KEY=your-32-character-staging-encryption-key

# ============================================================================
# EXTERNAL APIS - Staging/Test
# ============================================================================
ARBEITSAGENTUR_API_KEY=your-staging-arbeitsagentur-key
INDEED_API_KEY=your-staging-indeed-key
STEPSTONE_API_KEY=your-staging-stepstone-key

# ============================================================================
# APP CONFIGURATION - Staging
# ============================================================================
NEXT_PUBLIC_APP_URL=https://staging.visaassist.ai
NEXT_PUBLIC_APP_NAME=Visa Assist AI (Staging)
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered visa application assistance - Staging Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# INTEGRATIONS - Staging
# ============================================================================
# Google Calendar (Test)
GOOGLE_CLIENT_ID=your-staging-google-client-id
GOOGLE_CLIENT_SECRET=your-staging-google-client-secret

# Microsoft Calendar (Test)
MICROSOFT_CLIENT_ID=your-staging-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-staging-microsoft-client-secret

# DocuSign Demo
DOCUSIGN_INTEGRATION_KEY=your-staging-docusign-key
DOCUSIGN_USER_ID=your-staging-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-staging-docusign-account-id
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# ============================================================================
# MONITORING & ANALYTICS - Staging
# ============================================================================
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/staging-project-id
NEXT_PUBLIC_GA_ID=G-YOUR-STAGING-GA-ID
NEXT_PUBLIC_HOTJAR_ID=your-staging-hotjar-id
NEXT_PUBLIC_INTERCOM_APP_ID=your-staging-intercom-app-id

# ============================================================================
# FEATURE FLAGS - Staging (Enable All for Testing)
# ============================================================================
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PAYMENT_PROCESSING=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_CALENDAR_INTEGRATION=true
FEATURE_DOCUMENT_ANALYSIS=true
FEATURE_JOB_SEARCH=true
FEATURE_E_SIGNATURE=true

# ============================================================================
# RATE LIMITING - Staging (More Lenient)
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# ============================================================================
# LOGGING - Staging (More Verbose)
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_DESTINATION=console

# ============================================================================
# PERFORMANCE - Staging
# ============================================================================
NEXT_BUNDLE_ANALYZE=false
NEXT_CACHE_ENABLED=true
NEXT_EXPERIMENTAL_CACHE=true