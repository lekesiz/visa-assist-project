# Production Environment Variables Template
# Copy this file to configure your production environment

# ============================================================================
# DATABASE - Supabase Production
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-production-service-role-key

# ============================================================================
# AI PROVIDERS - Production Keys
# ============================================================================
OPENAI_API_KEY=sk-proj-your-production-openai-key
ANTHROPIC_API_KEY=sk-ant-api03-your-production-anthropic-key
GOOGLE_AI_KEY=AIzaSy-your-production-google-ai-key

# ============================================================================
# PAYMENT PROVIDERS - Production
# ============================================================================
# Stripe Production
STRIPE_SECRET_KEY=sk_live_your-stripe-production-secret
STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-production-publishable

# PayPal Production
PAYPAL_CLIENT_ID=AY-your-production-paypal-client-id
PAYPAL_SECRET=your-production-paypal-secret
PAYPAL_MODE=live

# ============================================================================
# EMAIL SERVICE - Production
# ============================================================================
SENDGRID_API_KEY=SG.your-production-sendgrid-key
EMAIL_FROM=noreply@visaassist.ai
EMAIL_REPLY_TO=support@visaassist.ai
EMAIL_ADMIN=admin@visaassist.ai

# ============================================================================
# FILE STORAGE - Production AWS S3
# ============================================================================
AWS_S3_BUCKET=visa-assist-documents-prod
AWS_ACCESS_KEY_ID=AKIA-your-production-aws-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret
AWS_REGION=eu-central-1
AWS_CLOUDFRONT_DOMAIN=d123456789.cloudfront.net

# ============================================================================
# SECURITY - Production
# ============================================================================
NEXTAUTH_SECRET=your-super-secure-production-nextauth-secret-32-chars-min
NEXTAUTH_URL=https://visaassist.ai
JWT_SECRET=your-super-secure-production-jwt-secret-32-chars-min
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================================================
# EXTERNAL APIS - Production
# ============================================================================
ARBEITSAGENTUR_API_KEY=your-production-arbeitsagentur-key
INDEED_API_KEY=your-production-indeed-key
STEPSTONE_API_KEY=your-production-stepstone-key

# ============================================================================
# APP CONFIGURATION - Production
# ============================================================================
NEXT_PUBLIC_APP_URL=https://visaassist.ai
NEXT_PUBLIC_APP_NAME=Visa Assist AI
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered visa application assistance
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# INTEGRATIONS - Production
# ============================================================================
# Google Calendar
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Microsoft Calendar
MICROSOFT_CLIENT_ID=your-production-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-production-microsoft-client-secret

# DocuSign
DOCUSIGN_INTEGRATION_KEY=your-production-docusign-key
DOCUSIGN_USER_ID=your-production-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-production-docusign-account-id
DOCUSIGN_BASE_URL=https://www.docusign.net/restapi

# ============================================================================
# MONITORING & ANALYTICS - Production
# ============================================================================
SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_GA_ID=G-YOUR-PRODUCTION-GA-ID
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id
NEXT_PUBLIC_INTERCOM_APP_ID=your-intercom-app-id

# ============================================================================
# FEATURE FLAGS - Production
# ============================================================================
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PAYMENT_PROCESSING=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_CALENDAR_INTEGRATION=true
FEATURE_DOCUMENT_ANALYSIS=true
FEATURE_JOB_SEARCH=true
FEATURE_E_SIGNATURE=true

# ============================================================================
# RATE LIMITING - Production
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# ============================================================================
# LOGGING - Production
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=console

# ============================================================================
# PERFORMANCE - Production
# ============================================================================
NEXT_BUNDLE_ANALYZE=false
NEXT_CACHE_ENABLED=true
NEXT_EXPERIMENTAL_CACHE=true